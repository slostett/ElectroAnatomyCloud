# Copy this file to .env and set your local paths.
# docker-compose.yml reads these variables at startup.

# Path to the folder containing EAM .mesh files
MESH_DIR=C:/Users/steph/Documents/UNC Cardiac Imaging/EAM data

# Path to the folder containing segmentation .nii.gz files
SEG_DIR=C:/Users/steph/Documents/UNC Cardiac Imaging/CT Data

# Path to the folder containing raw CT .nii.gz files
CT_DIR=C:/Users/steph/Documents/UNC Cardiac Imaging/CT Data

# Path for output files (writable)
RESULTS_DIR=C:/Users/steph/Documents/UNC Cardiac Imaging/results

# Set to 1 to enable Dash debug mode (shows error overlay, auto-reloads)
DASH_DEBUG=0
